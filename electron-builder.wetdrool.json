{
  "appId": "ai.drooly.wetdrool.desktop",
  "productName": "WetDrool",
  "directories": { "output": "dist/wetdrool", "buildResources": "build-wetdrool" },
  "files": ["src/**/*", "package.json"],
  "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }, { "target": "zip", "arch": ["arm64", "x64"] }], "category": "public.app-category.games" },
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
  "linux": { "target": [{ "target": "AppImage", "arch": ["x64"] }], "category": "Game" },
  "publish": null
}
